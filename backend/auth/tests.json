{
  "tests": [
    {
      "name": "CORS preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "Phone login disabled: request code",
      "method": "POST",
      "path": "/?action=request_code",
      "body": {
        "phone": "+79001234567"
      },
      "expectedStatus": 410,
      "expectedBody": {
        "error": "phone_login_disabled"
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Phone login disabled: verify code",
      "method": "POST",
      "path": "/?action=verify_code",
      "body": {
        "phone": "+79001234567",
        "code": "000000"
      },
      "expectedStatus": 410,
      "bodyMatcher": "partial"
    },
    {
      "name": "Me without token unauthorized",
      "method": "GET",
      "path": "/?action=me",
      "expectedStatus": 401,
      "bodyMatcher": "partial"
    },
    {
      "name": "Delete account without token unauthorized",
      "method": "DELETE",
      "path": "/?action=account",
      "expectedStatus": 401,
      "bodyMatcher": "partial"
    },
    {
      "name": "Delete account with bad token unauthorized",
      "method": "DELETE",
      "path": "/?action=account",
      "headers": {
        "X-Auth-Token": "bad-token"
      },
      "expectedStatus": 401,
      "bodyMatcher": "partial"
    },
    {
      "name": "Me with unknown token returns no user",
      "method": "GET",
      "path": "/?action=me",
      "headers": {
        "X-Auth-Token": "unknown-token"
      },
      "expectedStatus": 200,
      "expectedBody": {
        "user": null
      },
      "bodyMatcher": "partial"
    }
  ]
}